rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // دالة التحقق من هوية المشرف الرئيسي المعتمد للمنصة
    function isMasterAdmin() {
      return request.auth != null && request.auth.token.email != null && request.auth.token.email == "eng.naderkamel@gmail.com";
    }

    // 1. حسابات وبيانات الدارسين (users):
    match /users/{userId} {
      // السماح بجلب مستند واحد مباشر فقط عند تسجيل الدخول
      allow get: if true;
      // حظر سحب أو استعراض جدول وقائمة الدارسين بالكامل للعامة، وحصره فقط بالمشرف
      allow list: if isMasterAdmin();
      // السماح بإنشاء طلب انضمام جديد برتبة دارس وحالة انتظار فقط
      allow create: if request.resource.data.role == "student" && request.resource.data.status == "pending";
      // التعديل والحذف وتغيير الرتب محصور حصرياً بالمشرف الرئيسي
      allow update, delete: if isMasterAdmin();
    }

    // 2. الملاحظات والتأملات الشخصية للدارسين (personal_notes):
    match /personal_notes/{noteId} {
      // عزل مذكرات كل طالب ومنع اطلاع أي دارس آخر عليها
      allow read, write: if isMasterAdmin() || (resource == null || resource.data.userId == request.auth.uid || resource.data.userId == request.auth.token.email);
    }

    // 3. المحاضرات والكتب والرفوف الدراسية (lectures & books):
    match /lectures/{lecId} {
      // قراءة وتشغيل مستقر للجميع بدون أي عوائق في الصوت أو البث
      allow read: if true;
      // الإضافة والتعديل والحذف محصور حصرياً بالمشرف الرئيسي
      allow write: if isMasterAdmin();
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isMasterAdmin();
      
      // نصوص الصفحات المستخرجة للكتاب (Cloud Cache)
      match /cached_pages/{pageId} {
        allow read: if true;
        allow write: if isMasterAdmin();
      }
    }

    // 4. سلة المحذوفات والأرشيف (recycle_bin):
    match /recycle_bin/{item} {
      allow read, write: if isMasterAdmin();
    }

    // 5. الإشعارات السحابية (notifications):
    match /notifications/{notifId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isMasterAdmin();
    }

    // 6. تقارير وبلاغات الأعطال الفنية (error_reports):
    match /error_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isMasterAdmin();
    }

    // 7. إعدادات المنصة ومفاتيح الذكاء الاصطناعي (settings):
    match /settings/{doc} {
      allow read, write: if isMasterAdmin();
    }
  }
}
