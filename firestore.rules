rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isMasterAdmin() {
      return request.auth != null && request.auth.token.email != null && request.auth.token.email == "eng.naderkamel@gmail.com";
    }

    // 1. حسابات الدارسين
    match /users/{userId} {
      allow read, create, update, delete: if true;
    }

    // 2. الملاحظات الشخصية
    match /personal_notes/{noteId} {
      allow read, write: if true;
    }

    // 3. المحاضرات والكتب (تم تعديل allow write هنا فقط للسماح بحفظ الصوت والـ SRT وتحديثات الكتب)
    match /lectures/{lecId} {
      allow read, write: if true;
    }

    match /books/{bookId} {
      allow read, write: if true;
      match /cached_pages/{pageId} {
        allow read, write: if true;
      }
    }

    // 4. سلة المحذوفات
    match /recycle_bin/{item} {
      allow read, write: if true;
    }

    // 5. الإشعارات
    match /notifications/{notifId} {
      allow read, create, update, delete: if true;
    }

    // 6. تقارير الأعطال (تم التعديل هنا فقط للسماح بالقراءة والإدارة)
    match /error_reports/{reportId} {
      allow read, create, update, delete: if true;
    }

    // 7. سجل تتبع ونشاط الدخول الجديد
    match /login_logs/{logId} {
      allow read, create, delete: if true;
    }

    // 8. الإعدادات
    match /settings/{doc} {
      allow read, write: if isMasterAdmin();
    }

    // 9. دليل الدارس واللوائح الرسمية
    match /student_guide_docs/{docId} {
      allow read, write: if true;
    }
  }
}
